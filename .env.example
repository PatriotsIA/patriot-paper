# Patriots Platform API (local default matches `npm run dev` in patriots-platform-api)
# VITE_PLATFORM_API_URL=http://localhost:4000

# EmailJS (client-side form delivery)
# VITE_EMAILJS_SERVICE_ID=your_service_id
# VITE_EMAILJS_TEMPLATE_ID=your_template_id
# VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Optional override; production defaults to src/config/pledge-api.json
# VITE_PLEDGE_API_URL=http://localhost:4001
